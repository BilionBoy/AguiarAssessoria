<div class="modern-dashboard">
  <div class="page-header e_clientes-header">
    <div class="page-header-content">
      <div class="breadcrumb-wrapper">
        <div class="breadcrumb modern-breadcrumb">
          <a href="/" class="breadcrumb-item">
            <i data-lucide="home"></i>
          </a>
          <span class="breadcrumb-item active">
            <%= t("activerecord.models.#{ECliente.model_name.i18n_key}.other") %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="content-fluid">
    <!-- SEARCH -->
    <div class="search-section-fluid">
      <div class="search-filters-fluid">
        <%= search_form_for @q, html: { class: "filter-form-fluid", autocomplete: "off" } do |f| %>
          <div class="search-input-group">
            <label class="form-label">Buscar Clientes</label>
            <div class="search-input-wrapper">
              <i data-lucide="search" class="search-input-icon"></i>
              <%= f.search_field :nome_completo_or_cpf_cont,
                    class: "form-input-fluid",
                    placeholder: "Digite nome ou CPF..." %>
            </div>
          </div>
          <div class="form-actions-fluid">
            <button type="submit" class="btn btn-primary">
              <i data-lucide="search"></i> Buscar
            </button>
            <% if params[:q].present? %>
              <%= link_to e_clientes_path, class: "btn btn-secondary" do %>
                <i data-lucide="x-circle"></i> Limpar
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- TABELA -->
    <div class="table-section-fluid">
      <div class="table-header-fluid">
        <h3 class="table-title">
          <i data-lucide="list"></i> Lista de Clientes
        </h3>
        <div class="table-actions">
          <%= link_to new_e_cliente_path, class: "btn btn-new" do %>
            <i data-lucide="plus"></i> Novo Cliente
          <% end %>
        </div>
      </div>

      <div class="table-container-fluid">
        <table class="data-table-fluid">
          <thead>
            <tr>
              <th class="checkbox-col">
                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
              </th>
              <th>Empresa</th>
              <th>Nome</th>
              <th>CPF</th>
              <th>Matrícula</th>
              <th>Convênios</th>
              <th>Data Admissão</th>
              <th class="actions-col sticky-right">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @e_clientes.each do |e_cliente| %>
              <tr>
                <td>
                  <input type="checkbox" class="e_cliente-checkbox" value="<%= e_cliente.id %>">
                </td>
                <td><%= e_cliente.e_empresa&.nome_fantasia %></td>
                <td><%= e_cliente.nome_completo %></td>
                <td><%= e_cliente.cpf %></td>
                <td><%= e_cliente.matricula %></td>
                <td>
                  <% e_cliente.g_orgaos.each do |o| %>
                    <span class="badge-convenio"><%= o.descricao %></span>
                  <% end %>
                </td>
                <td><%= e_cliente.data_admissao&.strftime("%d/%m/%Y") %></td>
                <td class="actions-col sticky-right">
                  <div class="row-actions">
                    <%= link_to e_cliente_path(e_cliente), class: "action-icon", title: "Visualizar" do %>
                      <i data-lucide="eye"></i>
                    <% end %>
                    <%= link_to edit_e_cliente_path(e_cliente), class: "action-icon", title: "Editar" do %>
                      <i data-lucide="edit"></i>
                    <% end %>
                    <%= button_to e_cliente_path(e_cliente),
                          method: :delete,
                          data: { confirm: "Tem certeza?" },
                          class: "action-icon danger",
                          title: "Excluir" do %>
                      <i data-lucide="trash-2"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if respond_to?(:pagy_bootstrap_nav) && defined?(@pagy) %>
        <div class="pagination-wrapper-fluid">
          <%= pagy_bootstrap_nav(@pagy, link_extra: 'class="pagination-link"').html_safe %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .search-section-fluid { background:#fff; border-radius:14px; padding:1.25rem 1.5rem; margin-bottom:1.5rem; box-shadow:var(--shadow-sm); }
  .search-filters-fluid { display:flex; align-items:center; justify-content:space-between; gap:1.25rem; }
  .filter-form-fluid    { display:flex; width:100%; align-items:flex-end; gap:1rem; }
  .search-input-group   { flex:1; display:flex; flex-direction:column; gap:.35rem; }
  .form-label           { font-size:.7rem; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.04em; }
  .search-input-wrapper { position:relative; }
  .search-input-icon    { position:absolute; left:12px; top:50%; transform:translateY(-50%); width:16px; height:16px; color:#94a3b8; pointer-events:none; }
  .form-input-fluid     { height:44px; padding:0 14px 0 38px; border-radius:10px; border:1px solid #e2e8f0; min-width:280px; font-size:.9rem; transition:all .2s; }
  .form-input-fluid:focus { outline:none; border-color:var(--primary-blue); box-shadow:0 0 0 3px rgba(37,99,235,.12); }
  .form-actions-fluid   { display:flex; gap:.5rem; align-items:center; }

  .table-container-fluid { overflow-x:auto; }
  .actions-col  { width:140px; text-align:center; }
  .checkbox-col { width:40px; text-align:center; }
  .row-actions  { display:flex; justify-content:center; gap:.5rem; }

  .action-icon { width:38px; height:38px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center;
                 color:var(--primary-blue); background:transparent; border:none; cursor:pointer; transition:background .2s; }
  .action-icon:hover  { background:rgba(0,0,0,.05); }
  .action-icon.danger { color:#dc2626; }

  .sticky-right { position:sticky; right:0; background:white; box-shadow:-4px 0 6px rgba(0,0,0,.05); z-index:2; }

  .breadcrumb      { display:flex; align-items:center; gap:.5rem; }
  .breadcrumb-item { color:rgba(255,255,255,.8); text-decoration:none; font-size:.875rem; }
  .breadcrumb-item.active { color:white; font-weight:600; }

  .page-header { background:linear-gradient(135deg,var(--primary-blue) 0%,var(--primary-blue-dark) 100%); }
  .page-header-content { padding:1rem 1.5rem; max-width:1600px; margin:0 auto; }

  .form-actions-fluid .btn-secondary { background:#f8fafc; border:1px solid #e2e8f0; color:#475569; }
  .form-actions-fluid .btn-secondary:hover { background:#f1f5f9; }

  /* Badge convênios */
  .badge-convenio { display:inline-block; background:#eff6ff; color:#2563eb; border:1px solid #bfdbfe;
                    border-radius:6px; padding:2px 8px; font-size:.75rem; font-weight:600; margin:2px 2px 0 0; }
</style>
