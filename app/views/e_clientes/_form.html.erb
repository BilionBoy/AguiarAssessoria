<%= simple_form_for @e_cliente, html: { class: "modern-form" }, data: { turbo: false } do |f| %>
  <% if @e_cliente.errors.any? %>
    <div class="alert alert-danger" style="margin-bottom:16px;">
      <strong><%= pluralize(@e_cliente.errors.count, "erro") %> encontrados:</strong>
      <ul><% @e_cliente.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %></ul>
    </div>
  <% end %>
  <div class="form-wizard">
    <!-- HEADER -->
    <div class="wizard-header">
      <div class="wizard-steps">
        <div class="wizard-step active" data-step="1"><span>1</span>Identificação</div>
        <div class="wizard-step"        data-step="2"><span>2</span>Localização</div>
        <div class="wizard-step"        data-step="3"><span>3</span>Dados Funcionais</div>
        <div class="wizard-step"        data-step="4"><span>4</span>Documentos</div>
      </div>
      <div class="wizard-progress">
        <div class="wizard-progress-bar"></div>
      </div>
    </div>
    <!-- ===== STEP 1 – IDENTIFICAÇÃO ===== -->
    <div class="wizard-step-content" id="step1">
      <h3 class="step-title">👤 Identificação</h3>
      <div class="row g-3">
        <div class="col-12">
          <%= f.input :nome_completo, label: "Nome completo", placeholder: "Nome completo do cliente" %>
        </div>
        <div class="col-md-8">
          <%= f.input :nome_social, label: "Nome social", placeholder: "Nome social (opcional)" %>
        </div>
        <div class="col-md-4">
          <%= f.input :cpf, label: "CPF", input_html: { maxlength: 11, placeholder: "Somente números" } %>
        </div>
        <div class="col-md-4">
          <%= f.input :g_sexo_id,
                collection: GSexo.all,
                label_method: :descricao,
                value_method: :id,
                label: "Sexo",
                prompt: "Selecione" %>
        </div>
        <div class="col-md-5">
          <%= f.input :data_nascimento,
                as: :date,
                start_year: 1900,
                end_year: Date.today.year,
                order: [:day, :month, :year],
                label: "Data de nascimento" %>
        </div>
        <div class="col-md-3 d-flex align-items-end pb-2">
          <%= f.input :alfabetizado, as: :boolean, label: "Alfabetizado?" %>
        </div>
      </div>
    </div>
    <!-- ===== STEP 2 – LOCALIZAÇÃO & CONTATO ===== -->
    <div class="wizard-step-content" id="step2" style="display:none;">
      <h3 class="step-title">📍 Localização & Contato</h3>
      <div class="row g-3">
        <div class="col-md-4">
          <%= f.input :g_estado_id,
                collection: GEstado.all,
                label_method: :nome_fantasia,
                value_method: :id,
                label: "UF Nascimento",
                prompt: "Selecione" %>
        </div>
        <div class="col-md-4">
          <%= f.input :g_cidade_id,
                collection: GCidade.all,
                label_method: :nome_fantasia,
                value_method: :id,
                label: "Cidade Nascimento",
                prompt: "Selecione" %>
        </div>
        <div class="col-md-4">
          <%= f.input :g_bairro_id,
                collection: GBairro.all,
                label_method: :descricao,
                value_method: :id,
                label: "Bairro que morra",
                prompt: "Selecione" %>
        </div>
        <div class="col-12">
          <%= f.input :endereco, label: "Endereço completo", placeholder: "Rua, número, complemento" %>
        </div>
        <div class="col-md-8">
          <%= f.input :email, placeholder: "email@exemplo.com" %>
        </div>
        <div class="col-md-4">
          <%= f.input :telefone, label: "Telefone", input_html: { placeholder: "(99) 99999-9999" } %>
        </div>
        <div class="col-md-4">
          <%= f.input :g_banco_id,
                collection: GBanco.all,
                label_method: :nome_fantasia,
                value_method: :id,
                label: "Banco",
                prompt: "Selecione" %>
        </div>
        <div class="col-md-4">
          <%= f.input :agencia, label: "Agência", placeholder: "Agência" %>
        </div>
        <div class="col-md-4">
          <%= f.input :conta, label: "Conta", placeholder: "Conta" %>
        </div>
      </div>
    </div>
    <!-- ===== STEP 3 – DADOS FUNCIONAIS ===== -->
    <div class="wizard-step-content" id="step3" style="display:none;">
      <h3 class="step-title">⚙️ Dados Funcionais</h3>
      <div class="row g-3">
        <!-- Convênios (primeiro) -->
        <div class="col-12">
          <div class="field-section">
            <label class="section-label">Convênios <span class="hint">(pode selecionar mais de um)</span></label>
            <div class="convenios-grid">
              <input type="hidden" name="e_cliente[g_orgao_ids][]" value="">
              <% GOrgao.all.each do |orgao| %>
                <label class="convenio-item">
                  <input type="checkbox"
                         name="e_cliente[g_orgao_ids][]"
                         value="<%= orgao.id %>"
                         class="orgao-checkbox"
                         data-label="<%= orgao.descricao.to_s.downcase %>"
                         <%= "checked" if @e_cliente.g_orgaos.include?(orgao) %>>
                  <span><%= orgao.descricao %></span>
                </label>
              <% end %>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <%= f.input :matricula, placeholder: "Matrícula do cliente" %>
        </div>
        <!-- Data de Admissão (todos exceto INSS) — opcional -->
        <div id="admissao_field" class="col-md-4 conditional-block" style="display:none;">
          <%= f.input :data_admissao,
                label: "Data de Admissão",
                required: false,
                as: :string,
                input_html: {
                  type: "date",
                  value: @e_cliente.data_admissao&.strftime("%Y-%m-%d"),
                  class: "form-control"
                } %>
        </div>
        <!-- Bloco INSS -->
        <div id="inss_fields" class="col-12 conditional-block" style="display:none;">
          <div class="inner-section">
            <h4 class="inner-title">Dados INSS</h4>
            <div class="row g-2">
              <div class="col-md-4">
                <%= f.input :numero_beneficio, label: "Nº do benefício", placeholder: "Número" %>
              </div>
              <div class="col-md-8">
                <%= f.input :g_tipo_beneficio_id,
                      collection: GTipoBeneficio.all,
                      label_method: :descricao,
                      value_method: :id,
                      label: "Tipo de benefício",
                      prompt: "Selecione" %>
              </div>
              <div class="col-12">
                <%= f.input :possui_representante_legal,
                      as: :boolean,
                      label: "Possui representante legal?",
                      input_html: { id: "possui_rep_legal_check" } %>
              </div>
              <div id="rep_legal_fields" class="col-12 conditional-block" style="display:none;">
                <div class="row g-2">
                  <div class="col-md-8">
                    <%= f.input :nome_representante_legal, label: "Nome do representante", placeholder: "Nome completo" %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :cpf_representante_legal, label: "CPF do representante",
                          input_html: { placeholder: "Somente números", maxlength: 11 } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Bloco Federal -->
        <div id="federal_fields" class="col-12 conditional-block" style="display:none;">
          <div class="inner-section">
            <h4 class="inner-title">Dados Federal</h4>
            <div class="row g-2">
              <div class="col-12">
                <%= f.input :pensionista,
                      as: :boolean,
                      label: "É pensionista?",
                      input_html: { id: "pensionista_check" } %>
              </div>
              <div id="instituidor_fields" class="col-12 conditional-block" style="display:none;">
                <div class="row g-2">
                  <div class="col-md-8">
                    <%= f.input :nome_instituidor, label: "Nome do instituidor", placeholder: "Nome completo" %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :matricula_instituidor, label: "Matrícula do instituidor", placeholder: "Matrícula" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ===== STEP 4 – DOCUMENTOS ===== -->
    <div class="wizard-step-content" id="step4" style="display:none;">
      <h3 class="step-title">📎 Documentos</h3>
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.input :comprovante_residencia, as: :file, label: "Comprovante de Residência",
                input_html: { accept: "image/*,application/pdf" } %>
        </div>
        <div class="col-md-6">
          <%= f.input :foto_contracheque, as: :file, label: "Contracheque",
                input_html: { accept: "image/*,application/pdf" } %>
        </div>
        <div class="col-12">
          <%= f.input :documento_identificacao, as: :file, label: "Documento de Identificação",
                input_html: { accept: "image/*,application/pdf" } %>
        </div>
        <div class="col-12">
          <div class="field-section">
            <label class="section-label">Outros documentos <span class="hint">(até 3 arquivos)</span></label>
            <div class="row g-2 mt-1">
              <% 3.times do |i| %>
                <div class="col-md-4">
                  <label class="doc-slot-label">Arquivo <%= i + 1 %></label>
                  <input type="file" name="e_cliente[outros_documentos][]"
                         accept="image/*,application/pdf" class="doc-file-input">
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ACTIONS -->
    <div class="wizard-actions">
      <button type="button" id="prevBtn" style="display:none;">⬅ Anterior</button>
      <div class="wizard-actions-right">
        <%= link_to "Cancelar", e_clientes_path, class: "btn btn-light" %>
        <button type="button" id="nextBtn">Próximo ➡</button>
        <%= f.submit "Salvar Cliente", id: "submitBtn", style: "display:none;" %>
      </div>
    </div>
  </div>
<% end %>
<style>
  /* ===== WIZARD SHELL ===== */
  .form-wizard { display:flex; flex-direction:column; gap:16px; }

  /* ===== HEADER ===== */
  .wizard-header { background:#fff; padding:20px 24px 16px; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
  .wizard-steps  { display:flex; justify-content:space-between; gap:8px; }
  .wizard-step   { flex:1; text-align:center; color:#9ca3af; font-size:.78rem; font-weight:500; line-height:1.3; }
  .wizard-step span { display:block; width:32px; height:32px; margin:0 auto 5px; border-radius:50%;
                      background:#e5e7eb; line-height:32px; font-weight:700; font-size:.85rem; }
  .wizard-step.active      { color:#2563eb; }
  .wizard-step.active span { background:#2563eb; color:#fff; }
  .wizard-step.done span   { background:#10b981; color:#fff; }
  .wizard-progress         { height:3px; background:#e5e7eb; border-radius:2px; overflow:hidden; margin-top:14px; }
  .wizard-progress-bar     { height:100%; width:0%; background:#2563eb; transition:.3s; }

  /* ===== STEP CONTENT ===== */
  .wizard-step-content { background:#fff; padding:24px 28px; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
  .step-title { font-size:1rem; font-weight:700; color:#1e293b; margin:0 0 18px; }

  /* Layout via Bootstrap row/col */
  /* Remove margem dupla do simple_form dentro do row Bootstrap */
  .row > [class*="col"] .form-group { margin-bottom: 0; }

  /* ===== INNER SECTIONS ===== */
  .field-section { display:flex; flex-direction:column; gap:6px; }
  .section-label { font-size:.75rem; font-weight:600; color:#374151; text-transform:uppercase; letter-spacing:.04em; }
  .hint          { font-size:.72rem; font-weight:400; color:#9ca3af; text-transform:none; letter-spacing:0; }

  .inner-section { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px 18px;
                   border-left: 3px solid #2563eb; animation: slideDown .2s ease; }
  .inner-title   { font-size:.85rem; font-weight:700; color:#2563eb; margin:0 0 12px; }

  /* Data admissão section */
  #admissao_field { animation: slideDown .2s ease; }

  @keyframes slideDown {
    from { opacity:0; transform:translateY(-6px); }
    to   { opacity:1; transform:translateY(0); }
  }

  /* ===== CONVÊNIOS ===== */
  .convenios-grid { display:flex; flex-wrap:wrap; gap:8px; margin-top:4px; }

  label.convenio-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    background: #f1f5f9 !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 8px !important;
    padding: 7px 14px !important;
    cursor: pointer !important;
    transition: all .15s !important;
    font-size: .83rem !important;
    font-weight: 500 !important;
    color: #475569 !important;
    user-select: none !important;
    margin-bottom: 0 !important;
  }
  label.convenio-item span {
    color: #475569 !important;
    font-weight: 500 !important;
  }
  label.convenio-item:hover {
    background: #e0e7ff !important;
    border-color: #818cf8 !important;
  }
  label.convenio-item:hover span {
    color: #3730a3 !important;
  }
  /* Pill ativo (checked) */
  label.convenio-item:has(input:checked) {
    background: #2563eb !important;
    border-color: #2563eb !important;
  }
  label.convenio-item:has(input:checked) span {
    color: #fff !important;
    font-weight: 600 !important;
  }
  label.convenio-item input[type=checkbox] {
    accent-color: #2563eb;
    width: 14px !important;
    height: 14px !important;
    cursor: pointer !important;
    flex-shrink: 0 !important;
  }

  /* ===== DOCUMENTOS ===== */
  .doc-slot-label { display:block; font-size:.75rem; font-weight:600; color:#64748b; margin-bottom:4px; }
  .doc-file-input { border:1.5px dashed #cbd5e1; border-radius:8px; padding:8px 10px;
                    width:100%; background:#fafafa; font-size:.82rem; cursor:pointer; }
  .doc-file-input:hover { border-color:#93c5fd; background:#eff6ff; }

  /* ===== ACTIONS ===== */
  .wizard-actions       { display:flex; justify-content:space-between; align-items:center;
                          background:#fff; padding:14px 20px; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
  .wizard-actions-right { display:flex; gap:8px; align-items:center; }

  #prevBtn   { padding:9px 16px; border-radius:8px; border:none; background:#e5e7eb; cursor:pointer; font-weight:500; font-size:.88rem; }
  #nextBtn   { padding:9px 18px; border-radius:8px; border:none; background:#2563eb; color:#fff; cursor:pointer; font-weight:600; font-size:.88rem; }
  #submitBtn { padding:9px 18px; border-radius:8px; border:none; background:#10b981; color:#fff; cursor:pointer; font-weight:600; font-size:.88rem; }
  #prevBtn:hover   { background:#d1d5db; }
  #nextBtn:hover   { background:#1d4ed8; }
  #submitBtn:hover { background:#059669; }

  /* Reduz espaçamento interno do simple_form dentro do grid */
  .fg .form-group { margin-bottom:0; }
</style>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    let currentStep = 1;
    const totalSteps = 4;

    const stepHeaders  = document.querySelectorAll(".wizard-step");
    const stepContents = document.querySelectorAll(".wizard-step-content");
    const progress     = document.querySelector(".wizard-progress-bar");
    const prevBtn      = document.getElementById("prevBtn");
    const nextBtn      = document.getElementById("nextBtn");
    const submitBtn    = document.getElementById("submitBtn");

    function showStep(step) {
      stepContents.forEach((c, i) => c.style.display = (i + 1 === step ? "block" : "none"));
      stepHeaders.forEach((s, i) => {
        s.classList.toggle("active", i + 1 === step);
        s.classList.toggle("done",   i + 1 <  step);
      });
      progress.style.width       = ((step - 1) / (totalSteps - 1)) * 100 + "%";
      prevBtn.style.display      = step === 1          ? "none"         : "inline-block";
      nextBtn.style.display      = step === totalSteps ? "none"         : "inline-block";
      submitBtn.style.display    = step === totalSteps ? "inline-block" : "none";
    }

    nextBtn.onclick = () => { if (currentStep < totalSteps) { currentStep++; showStep(currentStep); } };
    prevBtn.onclick = () => { if (currentStep > 1)          { currentStep--; showStep(currentStep); } };
    showStep(currentStep);

    // ===== Convênios condicionais =====
    const checkboxes    = document.querySelectorAll(".orgao-checkbox");
    const admissaoField = document.getElementById("admissao_field");
    const inssFields    = document.getElementById("inss_fields");
    const federalFields = document.getElementById("federal_fields");

    function updateConvenioFields() {
      const selected = Array.from(checkboxes).filter(cb => cb.checked).map(cb => cb.dataset.label || "");
      const hasInss    = selected.some(l => l.includes("inss"));
      const hasFederal = selected.some(l => l.includes("federal"));
      const hasNonInss = selected.some(l => !l.includes("inss"));

      admissaoField.style.display = hasNonInss ? "block" : "none";
      inssFields.style.display    = hasInss    ? "block" : "none";
      federalFields.style.display = hasFederal ? "block" : "none";
    }

    checkboxes.forEach(cb => cb.addEventListener("change", updateConvenioFields));
    updateConvenioFields();

    // ===== Representante legal =====
    const repLegalCheck  = document.getElementById("possui_rep_legal_check");
    const repLegalFields = document.getElementById("rep_legal_fields");
    const toggleRepLegal = () => {
      if (repLegalFields) repLegalFields.style.display = repLegalCheck?.checked ? "block" : "none";
    };
    repLegalCheck?.addEventListener("change", toggleRepLegal);
    toggleRepLegal();

    // ===== Pensionista =====
    const pensionistaCheck  = document.getElementById("pensionista_check");
    const instituidorFields = document.getElementById("instituidor_fields");
    const toggleInstituidor = () => {
      if (instituidorFields) instituidorFields.style.display = pensionistaCheck?.checked ? "block" : "none";
    };
    pensionistaCheck?.addEventListener("change", toggleInstituidor);
    toggleInstituidor();
  });
</script>
