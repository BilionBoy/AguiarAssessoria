<style>
  /* ── Ficha de Contrato ── */
  .ficha-contrato {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  /* Header */
  .ficha-header {
    background: linear-gradient(135deg, #071c47 0%, #0d2d6b 100%);
    padding: 24px 32px;
    position: relative;
    overflow: hidden;
  }
  .ficha-header::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 0; height: 0;
    border-style: solid;
    border-width: 0 80px 80px 0;
    border-color: transparent #c8442a transparent transparent;
  }
  .ficha-header-title {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .ficha-header-sub {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 2px;
  }

  /* Sections */
  .ficha-section {
    padding: 24px 32px;
    border-bottom: 1px solid #f1f5f9;
  }
  .ficha-section:last-of-type {
    border-bottom: none;
  }
  .ficha-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 700;
    color: #c8442a;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid #fee2e2;
  }
  .ficha-section-icon {
    width: 28px;
    height: 28px;
    background: #c8442a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ficha-section-icon svg {
    width: 14px;
    height: 14px;
    color: white;
    stroke: white;
  }

  /* Footer actions */
  .ficha-actions {
    padding: 20px 32px;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .btn-ficha-salvar {
    background: #c8442a;
    color: white;
    border: none;
    padding: 10px 28px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
  }
  .btn-ficha-salvar:hover { background: #a83520; color: white; }
  .btn-ficha-voltar {
    background: white;
    color: #475569;
    border: 1px solid #cbd5e1;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
  }
  .btn-ficha-voltar:hover { background: #f1f5f9; color: #1e293b; }

  /* Simple form overrides inside ficha */
  .ficha-contrato .form-group { margin-bottom: 0; }
  .ficha-contrato label { font-size: 11px; font-weight: 700; color: #0f172a; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 4px; }
  .ficha-contrato .form-control,
  .ficha-contrato .form-select { font-size: 13.5px; border-color: #e2e8f0; border-radius: 6px; }
  .ficha-contrato .form-control:focus,
  .ficha-contrato .form-select:focus { border-color: #c8442a; box-shadow: 0 0 0 2px rgba(200,68,42,0.12); }
</style>

<%= simple_form_for @e_contrato, html: { class: "ficha-contrato", autocomplete: "off" }, data: { turbo: false } do |f| %>

  <% if @e_contrato.errors.any? %>
    <div class="alert alert-danger mx-4 mt-4" role="alert">
      <strong><%= pluralize(@e_contrato.errors.count, "erro") %>:</strong>
      <ul class="mb-0 mt-1 ps-3">
        <% @e_contrato.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- ══ HEADER DA FICHA ══ -->
  <div class="ficha-header">
    <p class="ficha-header-title">Ficha de Contrato</p>
    <p class="ficha-header-sub">Aguiar Assessoria &mdash; Crédito Consignado</p>
  </div>

  <!-- ══ SEÇÃO 1: CLIENTE ══ -->
  <div class="ficha-section">
    <div class="ficha-section-title">
      <div class="ficha-section-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
      </div>
      Dados do Cliente
    </div>

    <div class="row g-3">
      <div class="col-md-8">
        <%= f.input :e_cliente_id,
            collection: ECliente.all.order(:nome_completo),
            label_method: :nome_completo,
            value_method: :id,
            prompt: "Selecione o cliente...",
            label: "Cliente",
            input_html: { class: "form-select" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :numero_contrato,
            label: "Número do Contrato",
            placeholder: "Ex: 2024001",
            input_html: { class: "form-control" } %>
      </div>
    </div>
  </div>

  <!-- ══ SEÇÃO 2: OPERAÇÃO ══ -->
  <div class="ficha-section">
    <div class="ficha-section-title">
      <div class="ficha-section-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
        </svg>
      </div>
      Operação
    </div>

    <div class="row g-3">
      <div class="col-md-4">
        <%= f.input :g_tipo_operacao_id,
            collection: GTipoOperacao.all.order(:descricao),
            label_method: :descricao,
            value_method: :id,
            prompt: "Tipo de operação...",
            label: "Tipo de Operação",
            input_html: { class: "form-select" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :g_banco_id,
            collection: GBanco.all.order(:nome_fantasia),
            label_method: :nome_fantasia,
            value_method: :id,
            prompt: "Banco...",
            label: "Banco",
            input_html: { class: "form-select" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :g_margem_tipo_id,
            collection: GMargemTipo.all.order(:descricao),
            label_method: :descricao,
            value_method: :id,
            prompt: "Margem...",
            label: "Tipo de Margem",
            input_html: { class: "form-select" } %>
      </div>

      <div class="col-md-3">
        <%= f.input :produto,
            label: "Produto / Tabela",
            placeholder: "Ex: CDC, Refin...",
            input_html: { class: "form-control" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :quantidade_parcelas,
            as: :integer,
            label: "Prazo (parcelas)",
            placeholder: "Ex: 72",
            input_html: { class: "form-control" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :valor_parcela,
            label: "Valor da Parcela (R$)",
            placeholder: "0,00",
            input_html: { class: "form-control" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :valor_total,
            label: "Valor Liberado (R$)",
            placeholder: "0,00",
            input_html: { class: "form-control" } %>
      </div>

      <div class="col-md-3">
        <%= f.input :valor_comissao,
            label: "Comissão (R$)",
            placeholder: "0,00",
            input_html: { class: "form-control" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :g_status_contrato_id,
            collection: GStatusContrato.all.order(:descricao),
            label_method: :descricao,
            value_method: :id,
            prompt: "Status...",
            label: "Status do Contrato",
            input_html: { class: "form-select" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :data_pagamento,
            as: :date,
            label: "Data de Pagamento",
            input_html: { class: "form-control", type: "date" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :data_cadastro,
            as: :date,
            label: "Data de Cadastro",
            input_html: { class: "form-control", type: "date", value: Date.today } %>
      </div>
    </div>
  </div>

  <!-- ══ ACTIONS ══ -->
  <div class="ficha-actions">
    <%= link_to e_contratos_path, class: "btn-ficha-voltar" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
      Cancelar
    <% end %>
    <%= f.submit (@e_contrato.new_record? ? "Salvar Contrato" : "Atualizar Contrato"),
        class: "btn-ficha-salvar" %>
  </div>

<% end %>
